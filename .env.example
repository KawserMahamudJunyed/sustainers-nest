# Vercel -> Project -> Settings -> Environment Variables
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Browser-safe key used only by public CMS reads and Supabase Auth on the server.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Preferred server-only key for admin APIs. Never expose or commit this value.
SUPABASE_SECRET_KEY=sb_secret_...

# Legacy compatibility only. If you still use a legacy service_role key,
# the backend can read it from SUPABASE_SERVICE_ROLE_KEY, but Supabase now
# recommends a separate sb_secret_... key for server components.
# SUPABASE_SERVICE_ROLE_KEY=...
